
Macro "NRV" (Args)
Body:
    // model = FlowChart( { StartNodes } , { EndNodes } , Description)
    model = FlowChart({"Initial Processing"},{"Summaries"},)
    //
    // Nodes
    //
    // FlowChartNode(model,NodeName,MacroName,UI,Description)
    //
    FlowChartNode(model,"Initial Processing",,,)
    FlowChartNode(model,"Through Trips",,,)
    FlowChartNode(model,"Generation",,,)
    FlowChartNode(model,"Time of Day",,,)
    FlowChartNode(model,"Skimming",,,)
    FlowChartNode(model,"Calc Mode Shares",,,)
    FlowChartNode(model,"Distribution",,,)
    FlowChartNode(model,"Apply Mode Shares",,,)
    FlowChartNode(model,"Directionality",,,)
    FlowChartNode(model,"Highway Assignment",,,)
    FlowChartNode(model,"Feedback",,,)
    FlowChartNode(model,"Transit Assignment",,,)
    FlowChartNode(model,"Summaries",,,)
    //
    // Links
    //
    // FlowChartLink(model , FromNode , ToNode , Condition , Description , IsFeedbackLoop)
    //
    FlowChartLink(model,"Initial Processing","Through Trips",False,,)
    FlowChartLink(model,"Through Trips","Generation",False,,)
    FlowChartLink(model,"Generation","Time of Day",False,,)
    FlowChartLink(model,"Time of Day","Skimming",False,,)
    FlowChartLink(model,"Skimming","Calc Mode Shares",False,,)
    FlowChartLink(model,"Calc Mode Shares","Distribution",False,,)
    FlowChartLink(model,"Distribution","Apply Mode Shares",False,,)
    FlowChartLink(model,"Apply Mode Shares","Directionality",False,,)
    FlowChartLink(model,"Directionality","Highway Assignment",False,,)
    FlowChartLink(model,"Highway Assignment","Feedback",False,,)
    FlowChartLink(model,"Feedback","Skimming",2,,1)
    FlowChartLink(model,"Feedback","Transit Assignment",True,,)
    FlowChartLink(model,"Transit Assignment","Summaries",False,,)
    Return(model)
EndMacro


Macro "Initial Processing" (Args,Result)
    Attributes = {
        {"Class", {"GISDK"}},
        {"MacroNames", {"Initial Processing"}}
    }
EndMacro


